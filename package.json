{
  "name": "@inkdropapp/restyle",
  "version": "2.4.5",
  "license": "MIT",
  "description": "A system for building constraint-based UI components",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build --force",
    "test": "jest",
    "lint": "eslint '**/*.{ts,tsx}' && yarn typecheck",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint-fix": "eslint --fix '**/*.{ts,tsx}'",
    "prepublishOnly": "yarn run build",
    "deploy:documentation": "gh-pages -d documentation/build"
  },
  "publishConfig": {
    "access": "public",
    "@shopify:registry": "https://registry.npmjs.org"
  },
  "author": "Shopify Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shopify/restyle.git"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.0.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.5.6",
    "gh-pages": "^5.0.0",
    "jest": "^30.3.0",
    "prettier": "^3.9.6",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "@types/react": "^19.3.0"
  },
  "packageManager": "yarn@4.11.0",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "files": [
    "dist/*"
  ]
}
